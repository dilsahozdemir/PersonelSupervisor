<Window x:Class="PersonelSupervisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Takip Sistemi" Height="350" Width="525">
    <Grid>
        <TextBox Name="UsernameTextBox" Width="200" Height="30" Margin="10,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Center" />
        <PasswordBox Name="PasswordBox" Width="200" Height="30" Margin="10,50,10,0" VerticalAlignment="Top" HorizontalAlignment="Center" />
        <Button Content="Giriş Yap" Width="200" Height="40" Margin="10,100,10,0" VerticalAlignment="Top" HorizontalAlignment="Center" Click="LoginButton_Click"/>
    </Grid>
</Window>
